# ── Paths ─────────────────────────────────────────────
# Where each app stores its config/database (on the host).
CONFIG_ROOT=./config

# Your media root. MUST be a single folder containing:
#   movies/   Tv Shows/   music/   Downloads/   incomplete/
# Everything downloads and imports under here so hardlinks work.
# Windows example: E:\Media      Linux example: /mnt/media
DATA_ROOT=/path/to/media

# ── Identity ──────────────────────────────────────────
TZ=America/New_York
PUID=1000
PGID=1000

# ── Plex ──────────────────────────────────────────────
# Optional. Claim token (valid ~4 min): https://www.plex.tv/claim
PLEX_CLAIM_TOKEN=

# ── Optional: torrents + VPN ──────────────────────────
# Only used if you uncomment the gluetun + qbittorrent services.
VPN_SERVICE_PROVIDER=mullvad
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
